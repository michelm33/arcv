            _log_err "Aborted"
            _backCd
            _exit -1 ""
        fi
        echo
    fi

    if ! Str__isEmpty "$logMessage" ; then
        # Pull may fail if no commit yet
        git pull origin main &>/dev/null

        _log_high "Git adding files"
        git add . 

