:<<'EOF'
@return 1 when allowed, 0 when not allowed
EOF

Arcv__manageCommitInterval() {
    local interval=${Arcv__currentRepoData["commit-interval"]:-0}
    if Int__not0 $interval ; then

        local headTime=0
        Arcv__getInfoHeadTime headTime
        
        local elapsedTime
        Date__timestamp elapsedTime
        Int__dec elapsedTime "$headTime"

        #_log_vars headTime elapsedTime interval
        #_log "remaining $(($interval-$elapsedTime))"

        # Using Int__nears enables to introduce a tolerance margin
        if Int__nears "$elapsedTime" "$interval" 10 || Int__gt "$elapsedTime" "$interval"; then
            return 1
        else        
            _log_high "$(($interval-$elapsedTime)) secs remaining before allowing next commit."
            return 0
        fi
    else
        return 1
    fi  
}

:<<'EOF'
This function is a dead-end, i.e. no further operation should be done,
exception when ARCV__VARS["force-commit"] is true (forced commit)

If first arg is 0, it means all is fine. Simply display the non change message

Otherwise, this function handles the case where no content change was detected 
but the SHA fingerprints do not match. Possible cause may be a file which timestamp 
changed only, e.g. after a copy or a touch command.

If --fix was specified, the hash is corrected, or an error message is displayed.

@param[1] check result of initial SHA256 verification (0=ok)
@param[2] current revision
@param[3] recomputed hash for commit
@param[4] initial hash
@param[5] value of lastBackupappversiontarget of main loop
EOF
Arcv__manageNoDiffDetected() {
    local __inCheckRes=$1
    local __inArcVersion=$2
    local __inHash="$3"
    local __inLastHash="$4"
    local __inLastBackupappversiontarget="$5"

    if [ ${__inCheckRes} -eq 0 ]  ; then 
        Arcv__showCheckinHeaderStatus ${__inCheckRes} ${__inArcVersion} "${__inHash}" "${__inLastHash}"  
        
        if ${ARCV__VARS["force-commit"]} ; then
            return 0
        else
            _quit ""
        fi
    else
        # If no change in file contents is detected, either fix the hash if requested or check the permission changes with the head. In all case, SHA must be recomputed
        local resSHAComp=1             
        local sha256Data=""   
        Arcv__getSourceSHA256 __inHash sha256Data
        resSHAComp=$?

        if ${ARCV__VARS["fix-hash"]} ; then
            if [ $resSHAComp -eq 0 ]; then
                ARCV__VARS["backupappversiontarget"]="${__inLastBackupappversiontarget}"
                if Arcv__updateCurrentTargetSHA256 "${__inHash}" ; then
                    echo
                    _log "Successfully reset hash to '${__inHash}'" 
                    echo
                    _quit "" # exec "$0" "--subproc"
                else
                    _exit -81 "Failed to update hash file for source dir. Please check the log."
                fi
            else
                _exit -80 "Failed to recompute hash for source dir '${ARCV__VARS["backupsrc"]}'. Please check the log."
            fi

        else
            echo "">&2
            _log_err "            
No content was changed in this folder, but the SHA fingerprints do not match. 

Possible cause may be a file which timestamp changed only, e.g. after a copy or a touch command.

You may run 'arcv co' to sync with head again or 'arcv --fix' to fix the fingerprint.
"
            _quit ""
        fi
    fi
}

Arcv__checkEditor() {
    local editorApp
    YAML__get ".editor" editorApp

    if ! _undefined "$editorApp" && ! File__isExe "$editorApp" ; then
        _exit -1 "File editor '$editorApp' either does not exist or is not reachable via PATH. Please set properly 'editor' parameter in configuration (valid value or nothing)." 
    fi
}

Arcv__main() {
    local allargs=("$@")

    _log_dbg "${allargs[@]}"
	
	_initLogs

    _loadDep "gawk"                         # awk
    _loadDep "rsync"                        # awk
    _loadDep "coreutils"                    # sha256sum
    _loadDep "iproute2"
    _loadDep "diffutils"                    # diff is mandatory currently

    Sys__pool_init Arcv__threadPool "arcv_processes" 1000

    if ! _parseArgs "${allargs[@]}" ; then
            _exit -1 "Failed to parse arguments"
    fi

	if [ -z "${ARCV__VARS["ARCV_CONFIG"]}" ] ; then

		_log_warn "arcv has not been configured yet for user $USER. Creating a default configuration file"

		local defaultArcvCfg="${HOME}/arcv.yml"
		cp -f "${ARCV__VARS["MY_DIR"]}/template-arcv.yml" "$defaultArcvCfg" 
		if [ $? -ne 0 ] ; then
			_exit -1 "Failed to create default arcv configuration file ${defaultArcvCfg}"
		fi

		local cfgFile
		_getConfigFilePath cfgFile
		_appendConfig "arcv config" "$(realpath --relative-to "$HOME" "${defaultArcvCfg}")"
		cat << EOF

Successfully created the operational configuration file: $(_colorText $defaultArcvCfg white_reverse)

Please set up now $(_colorText $defaultArcvCfg white_reverse).

NOTE: 
The path to this file is saved into the main configuration file $(_colorText ${cfgFile} white_reverse).
This saved path is always relative to the HOME user folder.

NOTE:
To switch to another existing operational config file, one can use the -f option. 
-f only needs to be called once, it will also update ${cfgFile} accordingly.

EOF
		#SYNCFULL__VARS["PLAN"]="${SYNCFULL__VARS["MY_DIR"]}/backup-plan-full.yml"
		_quit ""
	fi

	ARCV__VARS["ARCV_CONFIG"]="${HOME}/${ARCV__VARS["ARCV_CONFIG"]}"
	if [ ! -f "${ARCV__VARS["ARCV_CONFIG"]}" ] ; then
		_exit -1 "Arcv configuration file '${ARCV__VARS["ARCV_CONFIG"]}' does not exist. Aborted."
	fi

    # true = read all and put in global yaml data map
    YAML__setFile "${ARCV__VARS["ARCV_CONFIG"]}" true 
    local subprocOverrideParam=false

    # Read subproc param which can override the one of the main config
    YAML__get ".subproc" subprocOverrideParam true
    if ${ARCV__VARS["subproc"]} || ${subprocOverrideParam} ; then
        ARCV__VARS["subproc"]=true
    fi

    local copy_cmd
    YAML__get ".copy-cmd" copy_cmd
    ARCV__VARS["copy"]="${copy_cmd}"
    local copy_args
    YAML__get ".copy-args" copy_args
    ARCV__VARS["copy_opt"]="${copy_args}"
    local copy_args_intern
    YAML__get ".copy-args-intern" copy_args_intern
    ARCV__VARS["copy_opt_intern"]="${copy_args_intern}"

    YAML__get ".exclude[]" excludedFiles
    #_log "exclude: ${excludedFiles[@]} ${#excludedFiles[@]}"

    YAML__get ".paging" ARCV__VARS["paging"]

    Arcv__checkEditor
    Arcv__resolveStoragePath storage

    # Option consistency
    if ${ARCV__VARS["check-in-list-only"]} && ! ${ARCV__VARS["checkin"]} ; then
        _exit 201 "-l option only allowed for check-in"
    fi

    # The list operation can and must be executed here immediately
    if ${ARCV__VARS["list"]} ; then
        Arcv__listSources "${ARCV__VARS["backuptarget"]}"
        return 0
    fi

    ARCV__VARS["backupapptarget"]="${ARCV__VARS["backuptarget"]}"           # Example Archive/sumo/sumo.archive, the sumo part will be added hereafter
    ARCV__VARS["backupappversiontarget"]="${ARCV__VARS["backuptarget"]}"    # Example Archive/sumo/sumo.archive/sumo.archiveX, the sumo part and version X will be added hereafter

    # At startup ARCV__VARS["backupsrc"] is an empty string
    # It is set either to an explicit source or current folder
    # by default
    #

    if [ -n "${ARCV__VARS["backupsrc"]}" ] &&  [ ! -d "${ARCV__VARS["backupsrc"]}" ] ; then
       _exit -1 "Source backup directory '${ARCV__VARS["backupsrc"]}' does not exist"
    elif [ -z "${ARCV__VARS["backupsrc"]}" ] ; then

        if ! Str__isEmpty "${ARCV__VARS["explicit_backupsrc"]}" ; then
            if  Arcv__initMongoDBRepoReference "${ARCV__VARS["explicit_backupsrc"]}" ; then
                ARCV__VARS["isFetchURL"]=true
            else
                Arcv__setExplicitSource "${ARCV__VARS["explicit_backupsrc"]}"
            fi
        else
            # This sets ARCV__VARS["backupsrc"] to the current workdirectory 
            File__cwd ARCV__VARS["backupsrc"]
            if [ $? -ne 0 ] ; then
                _exit -1 "Failed to determine current working directory. Was it removed or no permission rights?"
            fi
        fi
    fi

    if ${ARCV__VARS["fetch-update"]} && ! ${ARCV__VARS["checkin"]} ; then
        _exit -10 "--fetch is only valid for check-in."
    fi

    if ! Str__isEmpty "${ARCV__VARS["checkout_folder"]}" && ${ARCV__VARS["checkin"]} ; then
        _exit -10 "-o output folder is not allowed for a check-in. Please change to the target folder and retry."
    fi
    
    if ${ARCV__VARS["revive"]} && Str__isEmpty "${ARCV__VARS["checkout"]}" ; then
        _exit -12 "--revive is only valid when checking out (co command)"
    fi

    if ! ${ARCV__VARS["isFetchURL"]} && ${ARCV__VARS["remove-after-direct-fetch-commit"]} ; then
        _exit -11 "--rm is only allowed in conjunction with --source=<URI>"
    fi

    if Int__not0 ${ARCV__VARS["revision-cycle"]} && ! ${ARCV__VARS["checkin"]} ; then
        _exit -12 "--cycle is only allowed for the initial commit"
    fi

    # Create new archive directory if it does not exist
    local originbackupSrc="${ARCV__VARS["backupsrc"]}"
    #_log_vars ARCV__VARS["backupsrc"]

    Arcv__setBackupSrc "$originbackupSrc"

    #echo "originbackupSrc : '$originbackupSrc' '${ARCV__VARS["backupsrcBasename"]}' '${ARCV__VARS["backupsrc"]}'" >&2
    local repoNewlyCreated=false

    ARCV__VARS["root-resolved"]=false    
    
    while ! ${ARCV__VARS["root-resolved"]} ; do
    
        if ! Arcv__checkRootDir ; then

            # If the source dir in the repo could not be resolved and this 
            # is not a checking operation, then exit immediately.
            if ! ${ARCV__VARS["checkin"]} ; then
                break
            fi

            # Note If an explicit source was specified which root could not be resolved,
            # the app is exited directly from Arcv__checkRootDir as an error case

            if ! Str__isEmpty "${ARCV__VARS["explicit_backupsrc"]}" ] ; then
                if ${ARCV__VARS["isFetchURL"]} && ${ARCV__VARS["fetch-update"]}; then  

                    local question="Fetch '${ARCV__VARS["explicit_backupsrc"]}' into '${ARCV__VARS["backupsrcBasename"]}'"
