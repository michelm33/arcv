:<<'EOF'
Updates the head revision with the current source folder
NOTE: this is a subfunction called by createRevision()

UPDATE 22/07/2026:  when syncing source with head, do not care of excluded file list that that was used to create the revision's archive folder. 
There could be a problem if the same excluded path appears also in a subfolder, in which case they are not removed from the head, except if delete-exclude , but
we cannot do that of course. that there must always be a full synch done

UPDATE 22/07/2026: Files explicitly excluded with --exclude must still be excluded

@param [1] the new, last revision of the head
@param [2] The file containing the list of source files to be excluded from the copy (usually the files that didn't change)
EOF

Arcv__updateHeadRevision()
{
    local __inArcVersion=$1
    local res=1
    local headRevFile="${ARCV__VARS["headversion"]}/REV"

    # Rebuild the exclusion command option anew for forcing the copy of all files
    # 
    local excludeFilesCmd=""
    Arcv__setupCopyCmdExcludeFileFromRepoExcludeFile excludeFilesCmd


    # In the copy command specify ARCV__VARS["backupsrcBasename"] as explicit source target
    # folder because the name of local source might be different than that of the target  in
    # source the repository, especially when using --source when checking into a difference 
    # source
    # rsync: a trailing "/" in source avoids creating an additional directory level on target
    # So if backupsrcBasename does not exist, it is created an data copied inside
    # So if backupsrcBasename does exist, the data are simply copied inside
    local backupSrc="${ARCV__VARS["backupsrc"]}/"
    local targetSrc="${ARCV__VARS["headversion"]}/${ARCV__VARS["backupsrcBasename"]}"
    local cmdHeadUpdate="${ARCV__VARS["copy"]} ${ARCV__VARS["copy_opt_intern"]} --delete '${backupSrc}' '${targetSrc}' ${excludeFilesCmd}"

    if _debugging ; then _log_vars cmdHeadUpdate ; fi

    Arcv__opStart "Updating HEAD"
    echo "${__inArcVersion}" > "${headRevFile}" && eval "$cmdHeadUpdate" 1>/dev/null 
    res=$?
    Arcv__opEnd $res
    
    return $res
}


:<<'EOF'
This function is called to initialize internal references
when a matching entry in the repository was found for the 
source which path is passed as 2 argument, i.e.
there's an archive of the same name as the base folder name.

This sets:
 
  ARCV__VARS["backupapptargetrootfile"]
  ARCV__VARS["backupapptarget"]
  Calls 'Arcv__setBackupSrc' with the specified path
  Reads the source configuration file YAML into Arcv__currentRepoData map

@param[1] path of the ROOT file
@param[2] path to a local source folder
EOF
Arcv__initSourceRepoReference() {
    local __inRootFile="$1"
    local __inBackupSrc="$2"

    Arcv__setBackupSrc "${__inBackupSrc}"
    ARCV__VARS["backupapptargetrootfile"]="$__inRootFile"
    ARCV__VARS["backupapptarget"]="${ARCV__VARS["backuptarget"]}/${ARCV__VARS["backupsrcBasename"]}.archive"

    # Read the advanced source repository configuration
    local sourceRepoCfg="${ARCV__VARS["backupsrcBasename"]}.yml"
    Str__toLower sourceRepoCfg
    sourceRepoCfg="${ARCV__VARS["backupapptarget"]}/${sourceRepoCfg}"
    if File__fileExists "${sourceRepoCfg}" ; then
        YAML__readAll "${sourceRepoCfg}" Arcv__currentRepoData
        YAML__normalize Arcv__currentRepoData
    fi

    Arcv__updateSourceRepoConf "${ARCV__VARS["cm-cfg"]}"
}

:<<'EOF'
EOF
Arcv__updateSourceRepoConf() {
    if Str__isEmpty "$1" ; then
        return 0
    fi

    local sourceRepoCfg="${ARCV__VARS["backupapptarget"]}/${ARCV__VARS["backupsrcBasename"]}.yml"
    local args=()
    Array__fromString "$1" "=" args

    if ! File__fileExists "${sourceRepoCfg}" ; then echo > "${sourceRepoCfg}" ; fi

    #_log_vars sourceRepoCfg args[0] args[1]
    YAML__writeFile "${sourceRepoCfg}" "${args[0]}" "${args[1]}"
}

