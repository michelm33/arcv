:<<'EOF'
Top function to create a new revision
@param[1] start revision (normally 0)
EOF

Arcv__initiateRevision()
{
    local startRevNumber=$1

    #
    # Create the internal repo files
    #

    # App-specific top archive folder
    mkdir -p "${ARCV__VARS["backupapptarget"]}" || _exit -1 "Failed to create folder '${ARCV__VARS["backupapptarget"]}'"

    # Manage excluded file patterns
    Arcv__setupEXCLUDE "${ARCV__VARS["excluded_file_patterns"]}"

    # Root file
    Arcv__createROOT "${ARCV__VARS["storageViaNfs"]}"

    # Head folder and set ARCV__VARS["headversion"]
    Arcv__getInfoHeadDirPath ARCV__VARS["headversion"]
    _makeDir "${ARCV__VARS["headversion"]}" 

    # Current head revision
    echo "${startRevNumber}" > "${ARCV__VARS["headversion"]}/REV"

    # 'dropped' file folder
    Arcv__getInfoDroppedDirPath ARCV__VARS["droppedsrc"]
    _makeDir "${ARCV__VARS["droppedsrc"]}" 

    # 'releases' directory
    local releaseFolder=""
    Arcv__getInfoReleasesDirPath releaseFolder
    _makeDir "${releaseFolder}"

    # Create the config file in repo
    Arcv__updateSourceRepoConf "${ARCV__VARS["cm-cfg"]}"
    Arcv__updateSourceRepoConf ".rev-cycle=${ARCV__VARS["revision-cycle"]}"
    Arcv__updateSourceRepoConf ".rev-cycle-backup=${ARCV__VARS["cycle-save"]}"
    Arcv__updateSourceRepoConf ".commit-interval=${ARCV__VARS["revision-interval"]}"

    #
    # Create revision 0
    # Compute the SHA256 for the current source and store it
    #
    local sha256="0"
    local sha256Data=""
    local lastSha256="0"
    local res=1
    Arcv__compAndCheckSourceSHA256 "" sha256 lastSha256 sha256Data
    #_log_vars sha256

    local excludeFilesCmd=""
    Arcv__setupCopyCmdExcludeFileFromRepoExcludeFile excludeFilesCmd

    #_log_vars excludeFilesCmd excludeFilesTmp

    ARCV__VARS["backupappversiontarget"]=""
    local addedFiles=()
    local deletedFiles=()
    local changedFiles=()
    Arcv__createRevision startRevNumber "Creation" "${sha256}" "${excludeFilesCmd}" "${excludeFilesTmp}" "" addedFiles deletedFiles changedFiles
    res=$?
    if [ $res -eq 0 ] ; then
        if ${ARCV__VARS["verbose"]} ; then
            _log_high "Committed first revision signed $sha256"
        else
            _log_high "Committed first revision ${sha256:0:16}"
        fi
    fi
    return $res
}

:<<'EOF'
Subfunction to be called to create or complete the (ls) list of file patterns --ignore options to use from being included in the SHA256 computing 
@param[1] inout string giving the --ignore option(s). May be unchanged if no items have to be excluded. 
EOF
