:<<'EOF'
Updates the size file following a commit
2 cases : SIZE file already exists, only the size of new head is used to update total size based on the old header size
@param[1] archive path
@param[2] archive folder of the new committed revision
EOF

Arcv__getUpdateRepoSizeFile()
{
    local __inArchivePath="$1" # backupapptarget
    local __inBackupappversiontarget="$2"
    local sizeFile="${__inArchivePath}/SIZE"

    if File__readLines "$sizeFile" sizeFileLines 2>/dev/null ; then
        if [ ${#sizeFileLines[@]} -eq 3 ]  ; then
            local oldSize="${sizeFileLines[0]}"
            local oldHeadSize="${sizeFileLines[1]}" 
            local oldSizeTimestamp="${sizeFileLines[2]}"

            local newSizeTimestamp=0
            Arcv__getRepoHeadTime "${__inArchivePath}" newSizeTimestamp
            local newHeadSize=0
            File__getSize "${__inArchivePath}/head" newHeadSize
            local newRevSize=0
            File__getSize "${__inBackupappversiontarget}" newRevSize
            local newSize=0
            # Note: later remove also the size of the dropped file,
            # this could matter!
            Int__calc_r "( ($oldSize - $oldHeadSize) + $newRevSize + $newHeadSize)" newSize 

            sizeFileLines[0]="${newSize}"
            sizeFileLines[1]="${newHeadSize}"
            sizeFileLines[2]="${newSizeTimestamp}"
            File__writeLines "$sizeFile" sizeFileLines

            return 0
        fi
    fi

    # This forces update of the size file
    local archiveSize
    local headUpdateTime
    Arcv__getRepoSize "${__inArchivePath}" archiveSize headUpdateTime  &>/dev/null
}

