            printf "[$cnt/$total] $(_colorText "\\U2B24" blinking)  %s : computing size..." "$entry"
        fi

        #local useOnlyCache=true
        #if ${ARCV__VARS["force-refresh"]} ; then useOnlyCache=true; fi
        if Arcv__getRepoSize "${archivePath}" archiveSize headUpdateTime false &>/dev/null  ; then
            archiveSizes+=($archiveSize)
            Int__inc totalArchiveSize $archiveSize
            Int__max $maxArchiveSize $archiveSize maxArchiveSize
            # Convert size to readable size
            Math__byteSize2ReadableSize $archiveSize 3 archiveSize 
            archiveSize=${archiveSize// /} # Remove spaces
        else
            archiveSizes+=("0")
            archiveSize="unknown"
        fi
        #Date__date

        #
        # Format the header time UTC as a readable date
        #
        local headTimeYear
        Date__year headTimeYear "$headUpdateTime"
        if Str__same "$headTimeYear" "$curyear" ; then 
            actualDateFormat="${dateFormat}"
        else 
            actualDateFormat="${dateFormatOtherYear}"
        fi
        Date__date headUpdateTime "$headUpdateTime" "${actualDateFormat}"

        local dataRow=""
        dataRow+="${entry}"
        dataRow+=${fieldSep}
        dataRow+="${srcRev}"
        dataRow+=${fieldSep}
        dataRow+="${srcHash}"
        dataRow+=${fieldSep}
        dataRow+="${headUpdateTime}"
        dataRow+=${fieldSep}
        dataRow+="${userIds}"
        dataRow+=${fieldSep}
        dataRow+="${archiveSize}"
        tableRows+=("${dataRow}")

        #
        # In verbose mode, refresh the table dynamically as sizes are retrieved when refreshed
        #
        if ${ARCV__VARS["force-refresh"]}; then      
            Term__clear    
            Array__toString tableRows "
" allEntries
            Array__toTextTableExt "${allEntries}" "$fieldSep" "" tableParams
        fi

        Int__inc cnt

    done

    #
    # Update the size bar at the right
    #
    #totalArchiveSize
    local barSize=20
    local cnt=0
    local nbRows="${#tableRows[@]}"
    while [ $cnt -lt $nbRows ] ; do
        local asize="${archiveSizes[$cnt]}"
        local bar
        Str__progressBar bar "$asize" "$maxArchiveSize"
        tableRows[$cnt]="${tableRows[$cnt]}${fieldSep}${bar}"
        Int__inc cnt
    done

    #
    # Add the total size row
    #
    if [ $totalArchiveSize -gt 0 ] ; then
        Math__byteSize2ReadableSize $totalArchiveSize 1 totalArchiveSize    
    
        local dataRow=""
        dataRow+=""
        dataRow+=${fieldSep}
        dataRow+=""
        dataRow+=${fieldSep}
        dataRow+=""
        dataRow+=${fieldSep}
        dataRow+=""
        dataRow+=${fieldSep}
        dataRow+=""
        dataRow+=${fieldSep}
        dataRow+="${totalArchiveSize}"
        #dataRow+=${fieldSep}

        tableRows+=("")
        tableRows+=("${dataRow}")
    fi
    #
    # Print the table from the entries array
    #
    Array__toString tableRows "
" allEntries

    if ! ${ARCV__VARS["force-refresh"]}; then      
        Array__toTextTableExt "${allEntries}" "${fieldSep}" "" tableParams
    fi

    Term__restoreCursor        
}

:<<'EOF'
Gets the list of available source folders in the repository
@param[1] in path to the repository
@param[2] out ref to var containing the array of found source folders
EOF

Arcv__getRepoSourceList()
{
    local __repoFolder="$1"
    local -n __outSources=$2
    local line=""
    local entry=""
    __outSources=()
    while IFS='' read -r line ; do
        entry="${line%.*}"
