:<<'EOF'
This function enables to add an entry in the ROOT file of an authorized source folder according to the local host name and MAC.
The ROOT file path is passed as first argument and the source folder 
as second. 

If arguments are not specified, they are set up from internal variables assumed to be initialized properly :
ARCV__VARS["backuptarget"]
ARCV__VARS["backupsrcBasename"]
ARCV__VARS["backupsrc"]
EOF
Arcv__registerSource()
{
    local expectedRoot=""
    if [ $# -ge 1 ] ; then
        expectedRoot="$1"
    else
        expectedRoot="${ARCV__VARS["backuptarget"]}/${ARCV__VARS["backupsrcBasename"]}.archive/ROOT"
    fi

    local localSourcePath=""
    if [ $# -ge 2 ] ; then
        localSourcePath="$2"
    else
        localSourcePath="${ARCV__VARS["backupsrc"]}"
    fi

    
    trapFileExits "${expectedRoot}"

    echo "${ARCV__VARS["localHostName"]}/${ARCV__VARS["localHostMAC"]}: ${localSourcePath}" >> "${expectedRoot}"
    if [ $? -ne 0 ] ; then
        _exit -1 "Failed to update ${expectedRoot}. Permissions?"
    fi
}

:<<'EOF'
This important function is used to check whether a local source folder, 
which path is given by ARCV__VARS["backupsrc"], is under revision control.

It searchs for a folder name inside the repository and a match is found on the following
conditions
- The folder name in the remote repository holds the same name as of the basename of the passed local source folder.
- The local host and MAC are recognized to valid for the source folder.

If there's no match, it tries to find a match with the parent folder, and so forth.

If a match is found, Arcv__initSourceRepoReference is called and 0 is returned. Otherwise 1 is returned.
EOF
Arcv__checkRootDir()
{
    local found=false
    local initialBackupSrc="${ARCV__VARS["backupsrc"]}"
    local backupSrc="${initialBackupSrc}"
    local backupsrcBasename="${ARCV__VARS["backupsrcBasename"]}"
    local expectedRoot="${ARCV__VARS["backuptarget"]}/${backupsrcBasename}.archive/ROOT"

     #_log_vars initialBackupSrc backupsrcBasename expectedRoot

    # By definition if an explicit source is specified for a check-out,
    # do not check backupSrc is valid registered source folder
    if ! Str__isEmpty "${ARCV__VARS["explicit_backupsrc"]}" ] ; then
        if File__fileExists "${expectedRoot}"; then
            found=true  
        else
            # Error is handled in calling code
            return 1
        fi
    fi

    while ! $found && [ "${backupSrc}" != "/" ] && [ "${backupSrc}" != "$HOME" ]; do
        #_log_dbg "Arcv__checkRootDir backupsrc=${ARCV__VARS["backupsrc"]}, storedRootPath: $storedRootPath, expectedRoot:$expectedRoot"
        #Arcv__setBackupSrc "$(dirname "${ARCV__VARS["backupsrc"]}"})"
        expectedRoot="${ARCV__VARS["backuptarget"]}/${backupsrcBasename}.archive/ROOT"

        #_log_vars backupSrc  expectedRoot

        if File__fileExists "${expectedRoot}" ] ; then
            if Arcv__checkAndUpdateSourceDirAuthorizedLocationList "${expectedRoot}" "${backupSrc}" ; then
                found=true
            fi
        fi

        if $found ; then 
            break
        fi

        File__dirname "${backupSrc}" backupSrc

        # call this to always have ARCV__VARS["backupsrc"] and ARCV__VARS["backupsrcBasename"]        
        # up-to-date regard last valid file finding , because existence of directory
        # "${ARCV__VARS["backuptarget"]}/${ARCV__VARS["backupsrcBasename"]}.archive"
        # will be tested after the call of this function
        Arcv__setBackupSrc "${backupSrc}" 
        backupsrcBasename="${ARCV__VARS["backupsrcBasename"]}"
    done

    #if ! $found ; then
    #    _exit -1 "${expectedRoot} does not exist (repository corrupted?)"
    #fi
    #_log_vars found
    if $found ; then
    #echo "OK" >&2
        _log_dbg "Arcv__checkRootDir: repo found: $expectedRoot"      
        Arcv__initSourceRepoReference "$expectedRoot" "${backupSrc}" 
        return 0
    else
        if [ "${ARCV__VARS["backupsrc"]}" = "$HOME" ] || [ "${ARCV__VARS["backupsrc"]}" = "/" ]  ; then
            _log_dbg "Arcv__checkRootDir: No repo found, source folder restored to ${initialBackupSrc}"
            Arcv__setBackupSrc "${initialBackupSrc}"
        fi
        return 1
    fi
}

:<<'EOF'
From the passed 'ROOT' file , checks whether the 
the local source folder passed as 2nd argument is a valid source folder
registered in the ROOT according to the current MAC and local host name setting. 
If there's a match with the local host name and the source path but not 
the MAC, then an entry is added into the ROOT file
@param[1] path of the ROOT file
@param[2] path to a local source folder
@return 0 if the passed source folder is valid for the passed ROOT, 1 otherwise
EOF
Arcv__checkAndUpdateSourceDirAuthorizedLocationList()
{
    local __inRootFile="$1"
    local __inBackupSrc="$2"
    local isValidLocation=false

    declare -A storedRoots

    YAML__readAll "${__inRootFile}" storedRoots
    YAML__normalize storedRoots
    local storedRootPath
    local storedRootHostNameAndMAC
    for storedRootHostNameAndMAC in "${!storedRoots[@]}" ; do
        storedRootPath="${storedRoots[${storedRootHostNameAndMAC}]}"
        #_log_vars storedRootHostNameAndMAC  storedRootPath

        local storedDataFields=()
        Array__fromString "${storedRootHostNameAndMAC}" "/" storedDataFields

        # An entry exists for localhost with a matching MAC
        if [ "${storedRootHostNameAndMAC}" = "${ARCV__VARS["localHostName"]}/${ARCV__VARS["localHostMAC"]}" ] ; then
            # Also check the backup src path
            if  [ "${storedRootPath}" = "${__inBackupSrc}" ] ; then
                isValidLocation=true
                break
            else
                continue
            fi
        fi

        # Check if a registered source exists for the same host
        # but a different MAC
        #_log_vars storedDataFields[0] storedDataFields[1] storedRootPath ARCV__VARS["localHostName"] ARCV__VARS["localHostMAC"] __inBackupSrc
        if [ "${storedDataFields[0]}" = "${ARCV__VARS["localHostName"]}" ] &&  [ "${storedRootPath}" = "${__inBackupSrc}" ] ; then
            #_log_dbg "NOT FOUND BUT same hostname entry found $storedRootHostNameAndMAC. must add ${ARCV__VARS["localHostMAC"]}"
            if Arcv__registerSource "${__inRootFile}" "${__inBackupSrc}"; then
                isValidLocation=true
                break
            fi
        fi
    done

    if $isValidLocation ; then 
        return 0
    else
        return 1
    fi
}

Arcv__getEscapedSrcBasename()
{
    local -n __inEscapedSourceName="$1"
    Arcv__getEscapedSrcBasenameForSrc "${ARCV__VARS["backupsrcBasename"]}" "${!__inEscapedSourceName}"
}

Arcv__getEscapedSrcBasenameForSrc()
{
    local srcPath="$1"
    local -n __in_shafullpath_srcItemsEscaped="$2"
    __in_shafullpath_srcItemsEscaped="${srcPath}"
    Str__replace __in_shafullpath_srcItemsEscaped "/" "_"
    Str__replace __in_shafullpath_srcItemsEscaped " " "_"
    Str__replace __in_shafullpath_srcItemsEscaped "." "_"
}

:<<'EOF'
Computes and outputs the SHA256 fingerprint for the specified folder.
It relies on Arcv__getFolderSHA256() for the computation. This function only deals with the presentation to the user and error handling
@param[1] the input folder for which to compute the fingerprint
EOF
Arcv__showFolderSHA256()
{
    local inputFolder="$1"
    local repoSourceName=""

    trapDirExits "${inputFolder}" 

    local dirHash=""        
    if ! Arcv__getFolderSHA256 "${inputFolder}" dirHash repoSourceName ; then
        _exit -80 "Failed to compute hash for path '${inputFolder}'"
    fi
    # The hash of the head is stored in the last committed archive folder, not 
    # below head/
    if ${ARCV__VARS["verbose"]} ; then
        echo ""
        if [ -z "${repoSourceName}" ] ; then
            echo "Hash signature for $(realpath "${inputFolder}") :"
        else
            echo "Hash signature for $(realpath "${inputFolder}") using exclusions of repo source '${repoSourceName}':"
        fi
    fi
    echo "${dirHash}"
    return 0
}

