    # https://symbl.cc/en/collections/arrow-symbols/
    local srcTitle="SRC: ${ARCV__VARS["backupsrc"]}"
    local currentSrcBasename=""
    File__basename "${ARCV__VARS["backupsrc"]}" currentSrcBasename
    if ! Str__same "$currentSrcBasename" "${ARCV__VARS["backupsrcBasename"]}" ; then
        srcTitle+=$'\U276F'$'\U276F'
        #srcTitle+=$'\U276F'$'\U276F'$'\U276F'
