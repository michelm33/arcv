        _log_high "$lastVerMsg"
    else
        #lastVerMsg=$(_colorText "Last archived version is $(($__inArcVersion-1)) hash $__inHash" "white_reverse")
        lastVerMsg="REV: $(($__inArcVersion-1)) (hash $__inLastHash)"

