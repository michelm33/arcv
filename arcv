:<<'EOF'
Fetches the content of an URL into the specified output folder.
If the operation is done during a fetch-update during a checkin operation, 
then the fetched content is only kept if it differs from the current revision.
@param[1] URL. When "" or none supplied, the following Arcv__currentRepoData["fetch-url"] read from repo config file is used
@param[2] output folder. When "" or none is supplied, it is the current folder.
@param[3] a boolean telling whether this operation is done during a fetch-update of an existing source
EOF
Arcv__fetchUpdate() {
    local __inURL=""
    if [ $# -ge 1 ] && ! _undefined "$1" ; then
        __inURL="$1"
    else
        __inURL="${Arcv__currentRepoData["fetch-url"]}"
    fi

    # No value stored in repository, or --fetch used with a regular source not imported from URL
    if Str__isEmpty "${__inURL}"  ; then        
        return 1
    fi

    local __inOutputFolder=""
    if [ $# -ge 2 ] && ! _undefined "$2" ; then
        __inOutputFolder="$2"
    else
        __inOutputFolder="."
    fi

    local retDump=1
    if mongodb__isURL "${__inURL}" ; then
        Arcv__fetchUpdateMongoDB "${__inURL}" "${__inOutputFolder}"
        retDump=$?
    else
        _log_warn "'${__inURL}' is not a supported URI type"
    fi

    if ! Int__not0 "$retDump" ; then
        local __inIsFetchUpdate=false
        if [ $# -ge 3 ] && ! _undefined "$3" ; then
            __inIsFetchUpdate=$3
        fi    

        if ${__inIsFetchUpdate} ; then
            if $0 diff --fmt=plain &>/dev/null ; then
                # If there is no change, checkout the header
                $0 -y co &>/dev/null
            fi
        fi
    fi
    return $retDump
}

:<<'EOF'
Gets a MongoDB dump from the passed URI.
@param[1] MongoDB URI
@param[2] output folder
EOF
Arcv__fetchUpdateMongoDB() {
    local __inURL="$1"
    local __inOutputFolder="$2"

    if ! mongodb__decodeURL "${__inURL}" Arcv__mongodb[host] Arcv__mongodb[port] Arcv__mongodb[dbName] ; then
        _log_error "Failed to decode MongoDB URI '${__inURL}' (invalid?)"
        return 1
    fi

    #_log_vars __inURL
    local useSSHIfDistant=false    
    local dumpVerNums=()
    mongodb__dumpVersion dumpVerNums
    if Array__sizeMatch dumpVerNums 0 ; then 
        useSSHIfDistant=true
    elif [ "${dumpVerNums[0]}" -lt 100 ] ; then 
        useSSHIfDistant=true
    else
        useSSHIfDistant=false
    fi
    # Array__print dumpVerNums "." # DEBUG
    #_log_vars useSSHIfDistant # DEBUG

    local archivDatabaseName="mongo-db-${Arcv__mongodb[dbName]}.gz"
    mongodb__dump "${__inURL}" "${__inOutputFolder}/${archivDatabaseName}" $useSSHIfDistant
}


:<<'EOF'
Pushes data previously fetched to the specified URL. 

This function can only be called if a matching valid source was found in the repository

@param[1] URL. When "" or none supplied, the following Arcv__currentRepoData["fetch-url"] read from repo config file is used
@param[2] input source folder. When "" or none is supplied, it is the current folder.
EOF
Arcv__push() {
    local __inURL=""
    if [ $# -ge 1 ] && ! _undefined "$1" ; then
        __inURL="$1"
    else
        __inURL="${Arcv__currentRepoData["fetch-url"]}"
    fi

    # No value stored in repository, or --fetch used with a regular source not imported from URL
    if Str__isEmpty "${__inURL}"  ; then        
        return 1
    fi

    # If no argument given to push commad, then take the 
    # the current revision 
    # if push-arg is 'head', take the head ofthe URI passed to --source 
    # Otherwise checkout the needed revision
    local __inInputSourceFolder=""
    local cleanupSrcFolder=false
    if Str__isEmpty "${ARCV__VARS["push-arg"]}" ; then
        __inInputSourceFolder="."        
        ARCV__VARS["current-revision"]="current directory" #local actualRev="$($0 rev)"
    elif Str__same "head" "${ARCV__VARS["push-arg"]}" ; then
        __inInputSourceFolder="${ARCV__VARS["backupapptarget"]}/head/${ARCV__VARS["backupsrcBasename"]}"
        ARCV__VARS["current-revision"]="HEAD (rev $(cat "${ARCV__VARS["backupapptarget"]}/head/REV"))"
    else
        local checkoutDir="."
        local cmdCO="$0 co ${ARCV__VARS["push-arg"]} --source='${ARCV__VARS["backupsrcBasename"]}' --subproc -o ${checkoutDir}"
        
        if eval "$cmdCO" ; then
            __inInputSourceFolder="${checkoutDir}/${ARCV__VARS["backupsrcBasename"]}-"

            if Int__isInt "${ARCV__VARS["push-arg"]}" ; then
                __inInputSourceFolder+="rev"   # "rev" prefix for revisions
                ARCV__VARS["current-revision"]="revision ${ARCV__VARS["push-arg"]}"
            else
                ARCV__VARS["current-revision"]="tag ${ARCV__VARS["push-arg"]}"
            fi

            __inInputSourceFolder+="${ARCV__VARS["push-arg"]}" # Rev num or tag
            cleanupSrcFolder=true
        else
            _exit -1 "Aborted push: failed to checkout revision or release '${ARCV__VARS["push-arg"]}'. It may not exist."
        fi

    fi

    local retRestore=1
    if mongodb__isURL "${__inURL}" ; then   
        Arcv__pushMongoDB "${__inURL}" "${__inInputSourceFolder}"
        retRestore=$?
    else
        _log_warn "'${__inURL}' is not a supported URI type"
    fi

    # Cleanup whatever the result if a checkout was done
    if $cleanupSrcFolder ; then
        _monitor "Cleaning up '${__inInputSourceFolder}'" rm -r "${__inInputSourceFolder}" &>/dev/null
    fi

    return $retRestore
}

:<<'EOF'
Restores a MongoDB from a MongoDB dump file 
@param[1] MongoDB URI
@param[2] source input folder
EOF
Arcv__pushMongoDB() {
    local __inURL="$1"
    local __inInputSourceFolder="$2"

    if ! mongodb__decodeURL "${__inURL}" Arcv__mongodb[host] Arcv__mongodb[port] Arcv__mongodb[dbName] ; then
        _log_error "Failed to decode MongoDB URI '${__inURL}' (invalid?)"
        return 1
    fi

    #_log_vars __inURL
    local useSSHIfDistant=false    
    local dumpVerNums=()
    mongodb__dumpVersion dumpVerNums
    if Array__sizeMatch dumpVerNums 0 ; then 
        useSSHIfDistant=true
    elif [ "${dumpVerNums[0]}" -lt 100 ] ; then 
        useSSHIfDistant=true
    else
        useSSHIfDistant=false
    fi
    # Array__print dumpVerNums "." # DEBUG
    #_log_vars useSSHIfDistant # DEBUG

    local archivDatabaseName="mongo-db-${Arcv__mongodb[dbName]}.gz"
    local mongoRestoreOptions="--drop" # Newer tables won't get lost

    #_log_vars ARCV__VARS["root-resolved"] ARCV__VARS["backupsrc"] ARCV__VARS["headrev"] ARCV__VARS["current-revision"]
    #ARCV__VARS["headrev"]
    File__fileExists "${__inInputSourceFolder}/${archivDatabaseName}" || _exit -1 "$(realpath -m "${__inInputSourceFolder}/${archivDatabaseName}") does not exist"

    local question="Restore ${__inURL} from source '${ARCV__VARS["backupsrcBasename"]}' (${ARCV__VARS["current-revision"]})? 
ALL EXISTING DB DATA WILL GET LOST"
    
    if ! Input__confirm_high "$question" ; then 
        echo
        return 1
    fi
    echo

    local taskMessage="Pushing data into '${Arcv__currentRepoData["fetch-url"]}'"
    _monitor "$taskMessage" mongodb__restore "${__inURL}" "${__inInputSourceFolder}/${archivDatabaseName}" "$mongoRestoreOptions" $useSSHIfDistant
}


:<<'EOF'
