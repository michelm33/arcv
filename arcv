:<<'EOF'
Retrieves the lastest version found in history of a file
@param [1] in most recent revision from which to start the search
@param [2] file or dir path to search for relatively to source root
@param [3] out the path in the revision file in the repository
@param [4] out latest revision of the found antic file
@return 0 if found, anything else otherwise
EOF
Arcv__lookupAnticFile()
{
    local rev="$1"
    local file="$2"
    local -n __outAnticRevFile=$3
    local -n __outAnticRev=$4
    local relativeRepoSrcFile="${ARCV__VARS["backupsrcBasename"]}/${file}"
    local backupsrcBasename="${ARCV__VARS["backupsrcBasename"]}"

    while [ $rev -ge 0 ] ;do
        local adir="${ARCV__VARS["backupapptarget"]}/${ARCV__VARS["backupsrcBasename"]}.archive${rev}"
        local anticFileRevision="${adir}/${relativeRepoSrcFile}"
        #_log_vars anticFileRevision
        if File__exists "${anticFileRevision}" ; then 
            __outAnticRevFile="${anticFileRevision}"
            __outAnticRev=$rev
            return 0
        fi
        Int__dec rev
    done
    return 1 # Not found
}

