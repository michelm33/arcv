        #DEBUG
        #_log_vars __inExcludeFilesTmp
        #echo "Content of exclude file $(cat "${__inExcludeFilesTmp}")"
    
    # else  Do not print warning, it is allowed not having an exclude file
    #_log_warn "${FUNCNAME[0]} called but ARCV__VARS["backupapptargetexcludefile"] is not defined"
    fi
}


:<<'EOF'
Subfunction to be called to create or complete the file containing the pattern of the files to be prevented from being copied into the repository during a commit operation, according to the rsync command (see --exclude-from option)
@param[1] inout exclude file path. May be unchanged if no items have to be excluded. If the value is empty and there are files to be excluded, the variable will contain as return value the path to a new temporary file containing the list of exclusion patterns
EOF
Arcv__completeCopyCmdExcludeFileFromRepoExcludeFile()
{
    local -n __inExistingExcludeFilesTmp=$1

    #_log_warn "backupapptargetexcludefile: ${ARCV__VARS["backupapptargetexcludefile"]}" # DEBUG
    if [ ! -z  "${ARCV__VARS["backupapptargetexcludefile"]}" ] ; then
        if [ -z  "${__inExistingExcludeFilesTmp}" ] ; then
            local __excludeFilesTmp
            File__createTempFile __excludeFilesTmp
            __inExistingExcludeFilesTmp="${__excludeFilesTmp}"
        fi
        cat "${ARCV__VARS["backupapptargetexcludefile"]}" | awk '{ if (length($0) > 0) print "- " $0}' >> "${__inExistingExcludeFilesTmp}"
        
        #DEBUG
        #_log_vars __inExistingExcludeFilesTmp
        #echo "Content of exclude file $(cat "${__inExistingExcludeFilesTmp}")"
    fi
}

:<<'EOF'
This function sets up the rsync command (see --exclude-from option) for excluding 
the files to be prevented from being copied into the repository during a commit operation,
as defined with the --exclude command or at init.

It uses Arcv__completeCopyCmdExcludeFileFromRepoExcludeFile to  create a file containing the pattern of the files to be excluded. This file is referenced in the command, but is not itself
a returned value, only the command itself, unlike Arcv__completeCopyCmdExcludeFileFromRepoExcludeFile.

Note that if there's no exclusion, an empty string is just returned as command option
@param[1] out rsync command command option (see --exclude-from option)
EOF
Arcv__setupCopyCmdExcludeFileFromRepoExcludeFile()
{
    local -n __outSetupExcludeCommand=$1

    __outSetupExcludeCommand="" # Set to empty by default

    local excludeFilesTmp=""
    Arcv__completeCopyCmdExcludeFileFromRepoExcludeFile excludeFilesTmp    
    if ! Str__isEmpty "${excludeFilesTmp}" ; then
        __outSetupExcludeCommand="--exclude-from=${excludeFilesTmp}"
    fi
}

:<<'EOF'
Subfunction called by createRevision() to cancel repository update in case an error was
encountered during a commit
EOF
Arcv__rollbackRevision()
{
    local __inRollbackedRev=$1
    local res=1
    if [ -f "${ARCV__VARS["backupappversiontarget"]}" ] ; then
        Arcv__opStart "Rollback. Removing folder ${ARCV__VARS["backupappversiontarget"]}"
        rm -r "${ARCV__VARS["backupappversiontarget"]}"
        res=$?
        Arcv__opEnd $res

        if [ $res -ne 0 ] ; then
            _exit -1 "Rollback failed. Please remove manually the above mentioned folder to bring repo to a consistent state"
        fi
    fi

    local headRevFile="${ARCV__VARS["headversion"]}/REV"
    echo $(( ${__inRollbackedRev} - 1 )) > "${headRevFile}"
    res=$?
    if [ $res -ne 0 ] ; then
        _exit -1 "Failed to rollback file '${headRevFile}'. Please remove manually the above mentioned folder to bring repo to a consistent state"
    fi
    return $res
}


:<<'EOF'
Top function to  create a new revision, ie. it creates the file tree in the repository for the current app archive target version (ongoing new revision) 
@param[1] ref of var containing revision number. This may be changed when revisions are circular
@param[2] revision log
@param[3] integrity checksum
@param[4] rsync exclusion option based on present arg 5
@param[5] The temp file containing the list of source files to be excluded from the copy (usually the files that didn't change)
@param[6] The temp. file containing the list of deleted files for this revision
@param[7] ref to array var storing the list of added files
@param[8] ref to array var storing the list of deleted files
@param[9] ref to array var storing the list of changed files
EOF
Arcv__createRevision()
{
    local -n __inArcVersion=$1
    local __inRevLog="$2"
    local __inSHA256="$3"
    local __inExcludeFilesCmd="$4"
    local __inExcludeFilesTmp="$5"
    local __inExcludeDroppedFilesList="$6"
    local -n __inAddedFiles=$7
    local -n __inDeletedFiles=$8    # Not used at the moment. __inExcludeDroppedFilesList content is used to generate DROPPED
    local -n __inChangedFiles=$9    # Not used at the moment
    local silent=${ARCV__VARS["silent"]}
    local res=1
    
    #_log_vars __inArcVersion __inSHA256 __inExcludeFilesCmd 

    #
    # Manage circular revisions
    # - wraparound to 0 if cycle revision count is reached
    # - copy all files, not just the difference by reconstructing the excluded files command option
    local revCycle=${Arcv__currentRepoData["rev-cycle"]:-0}
    if Int__not0 $revCycle ; then
        if Int__eq ${__inArcVersion} $revCycle ; then
            __inArcVersion=0 
        fi
        Arcv__setupCopyCmdExcludeFileFromRepoExcludeFile __inExcludeFilesCmd
    fi
    
    # cat "${__inExcludeFilesTmp}" # DEBUG

    # Ensure correct definition of 'backupappversiontarget'
    local backupappversiontarget="${ARCV__VARS["backupapptarget"]}/${ARCV__VARS["backupsrcBasename"]}.archive${__inArcVersion}"
    local current_backupappversiontarget="${ARCV__VARS["backupappversiontarget"]}"
    Str__trimEnd "${current_backupappversiontarget}" current_backupappversiontarget "/"
    
    # If global var is already defined, check that it matches the expected one
    # except for circular revisions, for which the above constructed backupappversiontarget
    # is always reconstructed for the actual revision number
    if [ -z "${current_backupappversiontarget}" ] || Int__not0 $revCycle ; then
        ARCV__VARS["backupappversiontarget"]="${backupappversiontarget}"
    else
        # Only for non-circular revision, it is additionnally checked that
        # the internal backupappversiontarget matches the one reconstructed from other variables
        if [ "${current_backupappversiontarget}" != "${backupappversiontarget}" ] ; then
            _exit -1 "Internal error: revision archive folder is deemed to be '${backupappversiontarget}', but currently resolved one is '${current_backupappversiontarget}'" 
        fi
    fi
    
    #
    # Copy the data to the backup target folders
    #
    # When committing new revisions, additional copy options apply:
    #
    # - Prune empty directories: otherwise, if the source has a complex directory structure,
    #   but no file changed inside there, all dir tree would be recreated without any file inside
    #
    # - When revisions are cyclic, then remove any previous existing revision of the same number
    #
    local copyOptions="${ARCV__VARS["copy_opt"]}"
    copyOptions+=" --prune-empty-dirs"

    if Int__not0 ${revCycle} && File__dirExists "${ARCV__VARS["backupappversiontarget"]}"; then
        # NO: copyOptions+=" --delete"
        if ! _monitor "Removing antic revision ${__inArcVersion}" rm -rf "${ARCV__VARS["backupappversiontarget"]}/" ; then 
            return 1
        fi
    fi

    _makeDir  "${backupappversiontarget}"
    #_log_vars ARCV__VARS["backupappversiontarget"] ARCV__VARS["backupsrcBasename"] 

    # In the copy command specify ARCV__VARS["backupsrcBasename"] as explicit source target
    # folder because the name of local source might be different than that of the target  in
    # source the repository, especially when using --source when checking into a difference 
    # source
    # rsync: a trailing "/" in source avoids creating an additional directory level on target
    # So if backupsrcBasename does not exist, it is created an data copied inside
    # So if backupsrcBasename does exist, the data are simply copied inside
    local backupSrc="${ARCV__VARS["backupsrc"]}/"
    local targetSrc="${ARCV__VARS["backupappversiontarget"]}/${ARCV__VARS["backupsrcBasename"]}"
    #if File__dirExists "${targetSrc}" ; then _log_warn "Version archive folder '$targetSrc' already exists!" ; fi
    
    #_log_vars backupSrc targetSrc
    local cmd="${ARCV__VARS["copy"]} ${copyOptions} "${__inExcludeFilesCmd}" '${backupSrc}' '${targetSrc}'"

    #if $silent ; then Term__moveCursorUp 1 ; fi
    Arcv__opStart "Creating archive version ${__inArcVersion}"

    _logf "COMMAND: $cmd"
    eval "$cmd" > /dev/null
    #_log_vars cmd ARCV__VARS["backupappversiontarget"]
    res=$?    

    # If no line were selected by the filtering grep, 1 is returned, which is OK
    if [ $res -eq 1 ] ; then
        res=0   
    fi
    Arcv__opEnd $res
    
    if [ $res -eq 0 ]; then
        Arcv__updateCurrentTargetSHA256 "${__inSHA256}"
        # Should test $? and clean up folder in case of any error
        Arcv__updateCurrentTargetRevisionLog "${__inRevLog}"
        # Should test $? and clean up folder in case of any error

        if $silent ; then Term__eraseCurrentLine; fi
        Arcv__opStart "Cleaning archive version ${__inArcVersion} : pruning empty folders, removing symlinks"
        Arcv__cleanupNewRevision "${ARCV__VARS["backupappversiontarget"]}/${ARCV__VARS["backupsrcBasename"]}"
        res=$?
        Arcv__opEnd $res
    else
        Arcv__rollbackRevision ${__inArcVersion}
        return 1
    fi

    Arcv__updateHeadRevision ${__inArcVersion}
    if [ $? -ne 0 ] ; then
        Arcv__rollbackRevision ${__inArcVersion}
        return 1
    fi

    Arcv__updateBranchingInfo
    if [ $? -ne 0 ] ; then
        Arcv__rollbackRevision ${__inArcVersion}
        return 1
    fi

    # Create the list of added files
    if ! Array__sizeMatch __inAddedFiles 0 ; then
        Array__print __inAddedFiles "
" "- /" > "${ARCV__VARS["backupappversiontarget"]}/ADDED"
    fi

    # Create DROPPED file to keep trace of removed files. It will be needed for getRevisionImage
    if [ ! -z "${__inExcludeDroppedFilesList}" ] ; then
        mv "${__inExcludeDroppedFilesList}" "${ARCV__VARS["backupappversiontarget"]}/DROPPED"
    fi

    # Cleanup
    if [ ! -z "${__inExcludeFilesTmp}" ] ; then
        rm "${__inExcludeFilesTmp}" &>/dev/null
    fi

    Arcv__getUpdateRepoSizeFile "${ARCV__VARS["backupapptarget"]}" "${ARCV__VARS["backupappversiontarget"]}"

    return $res
}

:<<'EOF'
Subfunction called by log list to show files added in the revision,
for the current defined target version archive folder:
ARCV__VARS["backupappversiontarget"]}

The added files are simply those files that were copied in the revision folder
since identical files are not copied over and over again.
@param [1] Indentation for displaying the files
EOF

Arcv__showRevisionAddedFiles()
{
    local _inIndent=$1
    local revSrc="${ARCV__VARS["backupappversiontarget"]}/${ARCV__VARS["backupsrcBasename"]}"
    local ff

    if ! File__dirExists "${revSrc}" ] ; then
        # Now file may have been added and only some deleted. In that case, 'backupsrcBasename' does not exist
        return 0
    fi

    while IFS='' read -r ff ; do
        if [ -L "$ff" ] ; then continue ; fi
        local rel_ff="$(realpath --relative-to "${revSrc}" "$ff")"
        #_log_vars ff rel_ff revSrc
        if [ "${rel_ff}" != "." ] && [ ! -d "${ff}" ] ; then
            Arcv__setColor rel_ff blue_normal
            Str__spaces $((${_inIndent}+1))
            if [ "${ARCV__VARS[output_format]}" = plain ] ; then rel_ff="+ ${rel_ff}" ; fi
            echo -e "${rel_ff}"
        fi
    done< <(find "$revSrc")
}

