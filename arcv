Arcv__manageCommitCycleBackup() {
    local __inRevision="$1"

    local revCycle=${Arcv__currentRepoData["rev-cycle"]:-0}
    local revCycleBackup=${Arcv__currentRepoData["rev-cycle-backup"]:-false}
    if Int__not0 $revCycle && $revCycleBackup; then
        # In cyclic backups, revision number may wrap around 0 after call of Arcv__createRevision
        # Let's anticipate this step and check whether version is 0
        local nextVersion=$(( ${__inRevision} % $revCycle))
        if Int__eq $nextVersion 0 ; then  
            if ! _monitor "Performing cycle backup" $0 --source="${ARCV__VARS["backupsrcBasename"]}-cycles" -y -m "cycle backup for ${ARCV__VARS["backupsrcBasename"]}" ; then
                _exit 129 "Cyclic backup failed!"
            fi
        fi
    fi  
}

Arcv__manageCommitFetch() {
    local -n __inDoRemoveAfterFetch=$1

    if ${ARCV__VARS["fetch-update"]} && ! _undefined "${Arcv__currentRepoData["fetch-url"]}" && ! ${ARCV__VARS["checkformodif"]} ; then
        local taskMessage="Updating by fetching '${Arcv__currentRepoData["fetch-url"]}'"
        if _monitor "$taskMessage" Arcv__fetchUpdate "" "" true ; then
            if ${ARCV__VARS["remove-after-direct-fetch-commit"]}  ; then
                __inDoRemoveAfterFetch=true
            fi

            if ${ARCV__VARS["fetch-only"]} ; then
                _quit "Fetch complete. No check-in initiated"
            fi
        else
            _exit -1 "Aborted following fetch failure from ${Arcv__currentRepoData["fetch-url"]}"
        fi
    fi
}

